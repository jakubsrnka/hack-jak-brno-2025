{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "keyParts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "importance": {
            "enum": [1, 2, 3],
            "type": "number"
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "reason": {
            "type": "string"
          },
          "types": {
            "type": "array",
            "items": {
              "enum": ["__AVAILABLE_KEYPART_TYPES__"],
              "type": "string"
            },
            "minItems": 1
          }
        },
        "required": ["importance", "citations", "reason", "types"],
        "type": "object"
      },
      "type": "array"
    },
    "summary": {
      "type": "string",
      "maxLength": "__MAX_SUMMARY_LENGTH__"
    }
  },
  "required": ["summary", "keyParts"],
  "type": "object"
}
